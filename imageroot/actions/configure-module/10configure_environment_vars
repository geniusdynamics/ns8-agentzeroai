import json
import sys
import agent

data = json.load(sys.stdin)
host = data["host"]

# Agent Zero accepts browser requests only from the listed origins. Both
# schemes are allowed, as HTTP to HTTPS redirection may be disabled.
agent.write_envfile("agentzero.env", {
    "ALLOWED_ORIGINS": f"https://{host},http://{host}",
})
